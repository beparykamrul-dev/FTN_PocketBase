# Apply these headers at the existing reverse proxy.
# Keep CSP compatible with the vanilla FTN Local UI.
header X-Content-Type-Options "nosniff"
header Referrer-Policy "strict-origin-when-cross-origin"
header Permissions-Policy "camera=(), microphone=(), geolocation=()"
header X-Frame-Options "SAMEORIGIN"
header Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; worker-src 'self' blob:"
